{% extends "page.twig" %}

{% block title %}{{ "settings.title"|trans }}{% endblock %}

{% block content %}
    <div class="container mt-4">
        <h1>{{ "settings.title"|trans }}</h1>

        {% if app.request.query.get("flash") == "success" %}
            <div class="alert alert-success">{{ ("settings.flash.success." ~ app.request.query.get("action"))|trans }}</div>
        {% elseif app.request.query.get("flash") == "error" %}
            <div class="alert alert-danger">{{ ("settings.flash.error." ~ app.request.query.get("error"))|trans }}</div>
        {% endif %}

        <form method="post" action="{{ path("settings_save_action") }}" class="mt-3">
            {% for section in groupedSettings %}
                <div class="card my-3">
                    <div class="card-body">
                        <h3 class="card-title text-primary">{{ section.section.label|trans }}</h3>

                        {% for setting in section.options %}
                            {% set isInvalid = app.request.query.get("flash") == "error" and app.request.query.get("option") == setting.name %}
                            <div class="mt-3">
                                {% include "user/settings/type/" ~ setting.type ~ ".twig" %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

            <button type="submit" class="btn btn-primary">{{ "settings.save.button"|trans }}</button>
        </form>

        <form method="post" action="{{ path("settings_change_password_action") }}" class="mt-3">
            <div class="card my-3">
                <div class="card-body">
                    <h3 class="card-title text-primary">{{ "settings.section.change-password.label"|trans }}</h3>

                    <div class="mt-3">
                        <label class="form-label" for="settings-change-password-current">{{ "settings.change-password.current.label"|trans }}</label>
                        <input class="form-control" type="password" id="settings-change-password-current" name="current-password"/>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="settings-change-password-new">{{ "settings.change-password.new.label"|trans }}</label>
                        <input class="form-control" type="password" id="settings-change-password-new" name="new-password"/>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="settings-change-password-new-confirm">{{ "settings.change-password.new-confirm.label"|trans }}</label>
                        <input class="form-control" type="password" id="settings-change-password-new-confirm" name="new-password-confirm"/>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">{{ "settings.change-password.update.label"|trans }}</button>
        </form>
    </div>
{% endblock %}
