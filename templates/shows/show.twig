{% extends "page.twig" %}

{% block title %}{{ show.title }}{% endblock %}

{% macro navItem(path, parameters, title) %}
    <li class="nav-item">
        <a class="{{ html_classes("nav-link", {"active": app.request.attributes.get("_route") == path}) }}" href="{{ path(path, parameters) }}">{{ title }}</a>
    </li>
{% endmacro %}

{% block content %}
    <div class="row">
        <div class="col-lg-3 col-12 text-center">
            <img class="img-fluid rounded fullscreen-image image-poster" loading="lazy" src="{{ path("shows_show_image", {"show": show.id}) }}"/>
        </div>

        <div class="col-lg-9 col-12">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="mb-3">{{ show.title }}</h1>

                    {% include "components/show-badges.twig" with {"show": show} only %}

                    <small class="d-block">{{ "shows.count.seasons"|trans({"%count%": show.seasons|length}) }}</small>
                    <small class="d-block">{{ "shows.count.episodes"|trans({"%count%": show.totalEpisodes}) }}</small>
                </div>

                {% if is_granted("IS_AUTHENTICATED") %}
                    <div class="btn-group">
                        <button class="btn btn-primary btn-sm add-to-collection" data-type="show" data-item="{{ show.id }}" title="{{ "user.collections.add-item.title"|trans }}"><i class="fa-solid fa-folder-plus"></i></button>
                        <button class="btn btn-success btn-sm add-view" data-type="show" data-show-id="{{ show.id }}" title="{{ "views.add-show-view"|trans }}"><i class="fa-solid fa-check"></i></button>
                        <button class="btn btn-danger btn-sm remove-view" data-type="show" data-show-id="{{ show.id }}" title="{{ "views.remove-show-view"|trans }}"><i class="fa-solid fa-trash"></i></button>
                    </div>
                {% endif %}
            </div>

            {% if show.plot %}
                <span class="d-block my-3">{{ show.plot }}</span>
            {% endif %}
        </div>
    </div>

    <ul class="nav nav-underline flex-column flex-sm-row my-3">
        {{ _self.navItem("shows_seasons_page", {"show": show.id}, "shows.seasons"|trans) }}
        {{ _self.navItem("shows_random_episodes_page", {"show": show.id}, "shows.random-episodes"|trans) }}
        {% if is_granted("IS_AUTHENTICATED") %}
            {{ _self.navItem("shows_latest_watched_episodes_page", {"show": show.id}, "shows.latest-watched-episodes"|trans) }}
            {{ _self.navItem("shows_most_watched_episodes_page", {"show": show.id}, "shows.most-watched-episodes"|trans) }}
            {{ _self.navItem("shows_least_watched_episodes_page", {"show": show.id}, "shows.least-watched-episodes"|trans) }}
            {{ _self.navItem("shows_unwatched_episodes_page", {"show": show.id}, "shows.unwatched-episodes"|trans({"%count%": show.getUnwatchedEpisodes(watchStatsProvider)|length})) }}
        {% endif %}
    </ul>

    {% block showContent %}{% endblock %}
{% endblock %}
