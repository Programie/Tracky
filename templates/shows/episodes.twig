{% extends "shows/show.twig" %}

{% block showContent %}
    <h2>{{ "shows.all-episodes"|trans }}</h2>

    <form class="row my-3 align-items-center">
        <div class="col">
            <div class="form-floating">
                <select class="form-select" id="all-episodes-filter" name="filter">
                    {% for field in filters %}
                        <option value="{{ field }}"{% if activeFilter == field %} selected{% endif %}>{{ ("shows." ~ field ~ "-episodes")|trans }}</option>
                    {% endfor %}
                </select>
                <label for="all-episodes-filter">{{ "shows.filter"|trans }}</label>
            </div>
        </div>

        <div class="col">
            <div class="form-floating">
                <input type="text" class="form-control" id="all-episodes-range" name="range" placeholder="" value="{{ range }}"/>
                <label for="all-episodes-range">{{ "shows.episode-range"|trans }}</label>
            </div>
        </div>

        <div class="col">
            <button type="submit" class="btn btn-primary">OK</button>
        </div>
    </form>

    {% include "components/episode-list-wide.twig" with {"episodes": episodes, "displaySeason": true} only %}
{% endblock %}
